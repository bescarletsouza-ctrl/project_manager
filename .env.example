# Copie para .env (local) e cadastre as mesmas variáveis na Vercel.
# Os valores estão no painel do Supabase em Project Settings > API.

# Cliente (injetadas no bundle em tempo de build — precisam existir na Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Servidor (lidas em runtime pelo middleware de autenticação)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Opcional: só é necessária se algum dia o código passar a usar supabaseAdmin
# (src/integrations/supabase/client.server.ts). Hoje ninguém importa esse módulo.
# NUNCA exponha esta chave no cliente.
# SUPABASE_SERVICE_ROLE_KEY=
